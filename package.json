{
  "name": "murali-js",
  "version": "0.1.0",
  "description": "Murali JS is a deterministic, code-first animation engine built on the web platform.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    }
  },
  "bin": { "murali": "./dist/cli.js" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murali-engine/murali-js.git"
  },
  "homepage": "https://github.com/murali-engine/murali-js#readme",
  "bugs": {
    "url": "https://github.com/murali-engine/murali-js/issues"
  },
  "files": ["dist", "README.md"],
  "workspaces": ["examples"],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "render": "npm run build --silent && node dist/cli.js render",
    "example": "npm run build --silent && node scripts/run-example.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build && npm test"
  },
  "dependencies": {
    "@playwright/browser-chromium": "1.55.1",
    "commander": "^14.0.1",
    "esbuild": "^0.25.10",
    "ffmpeg-static": "^5.2.0",
    "playwright-core": "1.55.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=20" }
}
